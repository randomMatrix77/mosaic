<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/mosaic_app_icon_512"
        android:label="Mosaic"
        android:roundIcon="@drawable/mosaic_app_icon_512"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mosaic">
        <!-- Required for Android 12+ to expose the Fold's vendor-public OpenCL
             driver to this app's native linker namespace. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADB-only diagnostics use a fixed JSON command allow-list in Python.
             android.permission.DUMP keeps these entry points unavailable to
             ordinary applications while allowing the local shell to inspect the
             app during development. -->
        <activity
            android:name=".DebugCommandActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.mosaic.poc.DEBUG_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
